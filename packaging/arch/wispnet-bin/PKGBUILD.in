# Generated by scripts/prepare_aur.py; submit PKGBUILD, .SRCINFO and support files.
pkgname=wispnet-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Connect your devices and access their services'
arch=('x86_64')
url='https://wispnet.app'
license=('Apache-2.0')
depends=('glibc>=@GLIBC@' 'gcc-libs' 'python>=3.11' 'systemd' 'iptables' 'gtk3' 'libayatana-appindicator' 'xdg-utils')
provides=("wispnet=$pkgver")
conflicts=('wispnet' 'wispnet-git')
options=('!strip' '!debug')
install=wispnet-bin.install
source=("wispnet-${pkgver}-linux-x86_64.tar.gz::@URL@"
        'wispnet-host.service' 'wispnet-desktop.service' 'wispnet-firewall.service'
        'wispnet.desktop' 'wispnet-setup' 'package_system.py' 'wispnet-remove.hook' 'LICENSE' 'NOTICE')
sha256sums=(@CHECKSUMS@)

package() {
    local bundle="$srcdir/wispnet-linux-x86_64"
    install -dm755 "$pkgdir/opt/wispnet"
    cp -a "$bundle/bin" "$pkgdir/opt/wispnet/"
    # Builder-specific interpreter paths and bytecode are never distributed.
    find "$pkgdir/opt/wispnet" -type d -name __pycache__ -prune -exec rm -rf {} +
    printf '/usr/bin/python3\n' > "$pkgdir/opt/wispnet/bin/python-path"
    install -dm755 "$pkgdir/opt/wispnet/scripts"
    install -m644 "$bundle"/scripts/{firewall_helper,install_firewall_helper,node_request}.py "$pkgdir/opt/wispnet/scripts/"
    install -m644 "$srcdir/package_system.py" "$pkgdir/opt/wispnet/scripts/"
    cp -a "$bundle/bin/wispnet_desktop" "$pkgdir/opt/wispnet/scripts/"
    install -Dm755 "$srcdir/wispnet-setup" "$pkgdir/usr/bin/wispnet-setup"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/wispnet/bin/wispnet "$pkgdir/usr/bin/wispnet"
    ln -s /opt/wispnet/bin/Wispnet "$pkgdir/usr/bin/wispnet-desktop"
    printf '#!/bin/sh\nexec /usr/bin/python3 /opt/wispnet/scripts/node_request.py "$@"\n' > "$pkgdir/usr/bin/wispnet-node"
    chmod 755 "$pkgdir/usr/bin/wispnet-node"
    install -Dm644 "$srcdir/wispnet-host.service" "$pkgdir/usr/lib/systemd/user/wispnet-host.service"
    install -Dm644 "$srcdir/wispnet-desktop.service" "$pkgdir/usr/lib/systemd/user/wispnet-desktop.service"
    install -Dm644 "$srcdir/wispnet-firewall.service" "$pkgdir/usr/lib/systemd/system/wispnet-firewall.service"
    install -Dm644 "$srcdir/wispnet.desktop" "$pkgdir/usr/share/applications/wispnet.desktop"
    install -Dm644 "$bundle/bin/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/wispnet.png"
    install -Dm644 "$srcdir/wispnet-remove.hook" "$pkgdir/usr/share/libalpm/hooks/wispnet-remove.hook"
    install -Dm644 "$srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$bundle/vendor/iroh/LICENSE-BSD3" "$pkgdir/usr/share/licenses/$pkgname/iroh-LICENSE-BSD3"
    install -Dm644 "$bundle/apps/flutter/assets/fonts/Roboto_LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/Roboto_LICENSE.txt"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
