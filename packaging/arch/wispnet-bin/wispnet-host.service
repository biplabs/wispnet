[Unit]
Description=Wispnet host node (independent of relay role)
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/bin/wispnet agent --config %h/.config/wispnet-node/host.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=default.target
