{
    https_port 443
    http_port 18081
    admin off
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
    on_demand_tls {
        ask http://127.0.0.1:18080/_wispnet/allow
    }
}

relay.wispnet.app, https://relay.wispnet.app:8443 {
    tls {
        issuer acme {
            disable_http_challenge
            alt_tlsalpn_port 443
        }
    }
    reverse_proxy 127.0.0.1:18443
}

https://, https://:8443 {
    tls {
        on_demand
        issuer acme {
            disable_http_challenge
            alt_tlsalpn_port 443
        }
    }
    @public host *.wispnet.app
    handle @public {
        @internal path /_wispnet/* /_wipsnet/*
        respond @internal 404
        reverse_proxy 127.0.0.1:18080 {
            header_up Host {host}
            flush_interval -1
        }
    }
    respond 404
}
