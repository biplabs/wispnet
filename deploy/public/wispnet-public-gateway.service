[Unit]
Description=Wispnet owner-controlled public service gateway
After=network-online.target wispnet-relay.service
Wants=network-online.target
[Service]
ExecStart=%h/.local/libexec/wispnet-public-gateway/wispnet-public-gateway --config %h/.config/wispnet-public/gateway.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/wispnet-public-gateway
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=384M
TasksMax=128
LimitNOFILE=4096
[Install]
WantedBy=default.target
