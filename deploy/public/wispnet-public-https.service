[Unit]
Description=Wispnet public HTTPS and packet relay front end
After=network-online.target wispnet-public-gateway.service
Wants=network-online.target wispnet-public-gateway.service
[Service]
Environment=XDG_DATA_HOME=%h/.local/share/wispnet-public-https
Environment=XDG_CONFIG_HOME=%h/.local/share/wispnet-public-https/config
ExecStart=/usr/bin/caddy run --config %h/.config/wispnet-public/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/wispnet-public-https
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=256M
TasksMax=128
LimitNOFILE=4096
[Install]
WantedBy=default.target
