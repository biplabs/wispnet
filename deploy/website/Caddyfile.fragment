# Merge this exact apex host into the existing HTTPS configuration.
# Preserve relay, wildcard service routes, and the Command Center host.
wispnet.app {
    root * /home/johnny/.local/share/wispnet-website/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
    file_server
}
