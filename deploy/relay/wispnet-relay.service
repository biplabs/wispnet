[Unit]
Description=Wispnet temporary packet relay (independent of node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/wispnet-relay/wispnet-relay --config %h/.config/wispnet-relay/relay.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/wispnet-relay/acme
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=256M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=default.target
