{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispnet",
  "version": "0.1.0",
  "identifier": "app.wispnet.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Wispnet", "width": 1080, "height": 740, "minWidth": 850, "minHeight": 580, "visible": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": { "active": false, "icon": ["../../node/desktop/icon.png"], "macOS": { "minimumSystemVersion": "13.0" } }
}
